# .env.example — variables d'environnement du backend (copier en .env).
# À contenir au minimum :
#   DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/routegestion
#   CORS_ORIGINS=http://localhost:3000,http://localhost:19006
#   ENV=dev
#   STORAGE_DIR=./storage            # fichiers des documents, HORS du public
#   TOKEN_TTL_DAYS=7
# Jamais de vrai mot de passe ici : .env n'est pas versionné.

