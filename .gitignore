# .gitignore — exclusions git du projet RouteGestion (racine).
# Couvre les 3 apps : backend (Python), admin-web (Next.js), mobile (Expo).

# Python / backend
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node / Next.js / Expo
node_modules/
.next/
.expo/
dist/
build/
*.tsbuildinfo

# Secrets et données locales (les .env.example sont versionnés)
.env
.env.local
.env.*.local
storage/
uploads/

# Logs et IDE
*.log
.idea/
.vscode/
.DS_Store

